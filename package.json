{
  "name": "jastiphub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch jastiphub-backend/src/index.js --dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env jastiphub-backend/src/index.js",
    "db:migrate": "node --env-file-if-exists=.env jastiphub-backend/src/migrate.js",
    "db:seed": "node --env-file-if-exists=.env jastiphub-backend/src/database/seed.js",
    "lint": "eslint .",
    "format": "prettier --write jastiphub-backend/src jastiphub-frontend/src jastiphub-frontend/index.html *.js package.json",
    "format:check": "prettier --check jastiphub-backend/src jastiphub-frontend/src jastiphub-frontend/index.html *.js package.json"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.1.0",
    "vite": "^7.2.0"
  }
}
