# Node 24+. Copy to .env only when overriding these defaults.
# Development is the default. For deployment set NODE_ENV=production.
PORT=5173
# For deployment set APP_ORIGIN to the public HTTPS URL.
# APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SAME_SITE=lax
# SQLite is created automatically. Relative paths are relative to the backend folder.
DB_PATH=.data/jastiphub.sqlite
UPLOAD_DIR=.data/uploads
# Demo defaults to on for loopback development. Uncomment to switch it off.
# ENABLE_DEMO=false
# Only set when behind a known reverse proxy; 0 means no proxy.
TRUST_PROXY=0
