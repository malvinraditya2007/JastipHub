# Development: Vite forwards /api and /uploads to this backend.
API_PROXY_TARGET=http://127.0.0.1:3001

# Leave empty for the Vite proxy or a same-origin production reverse proxy.
# For a separate API origin, use its origin without /api/v1 or a trailing slash.
# Example: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=
