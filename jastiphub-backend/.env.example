# Node 24+. Copy to .env in this backend folder and fill the connection details.
# Development is the default. For deployment set NODE_ENV=production.
PORT=5173
# For deployment set APP_ORIGIN to the public HTTPS URL.
# APP_ORIGIN=http://127.0.0.1:5173
COOKIE_SAME_SITE=lax
# Fill these from TiDB Cloud > Connect. Create the database in TiDB first.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=jastiphub
# TiDB Cloud requires TLS. For local MySQL use port 3306 and DB_SSL=false.
DB_SSL=true
# Upload paths are relative to the backend folder.
UPLOAD_DIR=storage/uploads
# Only enable demo data deliberately; demo login is always disabled in production.
ENABLE_DEMO=false
# Only set when behind a known reverse proxy; 0 means no proxy.
TRUST_PROXY=0
