# Node 24+. Copy to .env and fill in your cloud MySQL connection.
# Development is the default. For deployment set NODE_ENV=production.
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
# For a frontend on a different site in production, use none with HTTPS.
COOKIE_SAME_SITE=lax
# Use DATABASE_URL OR the individual DB_* values below.
# DATABASE_URL=mysql://username:password@host:3306/jastiphub
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jastiphub
# Enable TLS for a cloud database. Verification always stays enabled.
DB_SSL=false
# Optional path to the provider's CA certificate.
DB_SSL_CA=
# TiDB Cloud MySQL-compatible: use the supplied host/user/database,
# usually DB_PORT=4000 and DB_SSL=true. No CA file is needed for a public trusted CA.
UPLOAD_DIR=.data/uploads
# Development only. Production refuses demo login and never seeds demo accounts.
ENABLE_DEMO=true
# Only set when behind a known reverse proxy; 0 means no proxy.
TRUST_PROXY=0
